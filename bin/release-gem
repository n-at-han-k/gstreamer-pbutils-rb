#!/usr/bin/env ruby
# frozen_string_literal: true

# Released under the Apache License, Version 2.0.
# Copyright, 2026, by General Intelligence Systems.

# RELEASE-GEM(1)                     General Commands Manual                   RELEASE-GEM(1)
#
# NAME
#      bin/release-gem — publish this version
#
# SYNOPSIS
#      bin/release-gem [gem kit release arguments ...]
#
# DESCRIPTION
#      Releasing is one `gem build` and one `gem push`. This gem is pure Ruby — the binding
#      is GObjectIntrospection::Loader reading gst-plugins-base's typelib at require time —
#      so one artefact serves every platform and there is no per-platform gem to collect.
#
#      That is the whole of what this script used to exist to work around. The Rust binding
#      this repository opened with needed a precompiled gem per platform, built in CI, and a
#      release meant downloading those artefacts and pushing them alongside the source gem.
#      None of that applies now, and `gem kit release` applies gates this script would
#      otherwise have to reimplement: a changelog entry for this version, no deprecation
#      past its deadline, a clean working tree.
#
#      So this is a thin wrapper. It checks the local version is ahead of what is published
#      — the one mistake that cannot be taken back, because a pushed version is pushed —
#      and then hands over. Arguments are passed straight through, so
#      `bin/release-gem --dry-run` gets you the gates without the push.
#
# EXIT STATUS
#      The bin/release-gem utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/test(1), gem(1), AGENTS.md "Release"
#
# gstreamer_pbutils                      November 3, 2026                      RELEASE-GEM(1)

require_relative "../lib/gstreamer_pbutils/version"

gem_name = "gstreamer_pbutils"
local_version = GstreamerPbutils::VERSION

puts "Local version: #{local_version}"

remote_output = `gem specification #{gem_name} version --remote 2>&1`
remote_version = $?.success? ? remote_output[/version: (.+)/, 1]&.strip : nil

if remote_version
  puts "Remote version: #{remote_version}"

  if Gem::Version.new(local_version) <= Gem::Version.new(remote_version)
    abort "ERROR: Local version (#{local_version}) has not been incremented past remote (#{remote_version})"
  end
else
  puts "Gem not yet published remotely, proceeding with first release"
end

exec("gem", "kit", "release", *ARGV)
